{
  "name": "mdctl",
  "version": "0.1.0",
  "description": "Live monitor for AI-context markdown (CLAUDE.md, AGENTS.md, Cursor rules, skills, docs) with git, history, link graph and health checks.",
  "type": "module",
  "bin": {
    "mdctl": "dist/mdctl.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node src/cli.js start",
    "ui:dev": "vite --config ui/vite.config.js",
    "ui:build": "vite build --config ui/vite.config.js",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "chokidar": "^4.0.3",
    "d3-array": "^3.2.4",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.2",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  }
}
