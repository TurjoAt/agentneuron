{
  "name": "agentneuron",
  "version": "1.0.0",
  "description": "Local dashboard, CLI and MCP server for AI coding agents: watch Claude Code and Codex edit files live, track session cost, tokens and tools, replay sessions, verify CLAUDE.md/AGENTS.md against your repo.",
  "keywords": [
    "claude-code",
    "claude-md",
    "agents-md",
    "cursor-rules",
    "copilot-instructions",
    "gemini-md",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "context-engineering",
    "codex",
    "claude",
    "llm",
    "developer-tools",
    "cli",
    "dashboard",
    "lint",
    "agent-monitoring",
    "claude-code-usage",
    "token-usage",
    "ai-cost-tracking"
  ],
  "author": {
    "name": "Rezaul Hoque Turjo",
    "email": "hi@turjo.me",
    "url": "https://turjo.me"
  },
  "homepage": "https://github.com/TurjoAt/agentneuron#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TurjoAt/agentneuron.git"
  },
  "bugs": {
    "url": "https://github.com/TurjoAt/agentneuron/issues",
    "email": "hi@turjo.me"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentneuron": "dist/agentneuron.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "node src/cli.js start",
    "ui:dev": "vite --config ui/vite.config.js",
    "ui:build": "vite build --config ui/vite.config.js",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "node scripts/build.mjs --strict && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "chokidar": "^4.0.3",
    "d3-array": "^3.2.4",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.57.2",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  }
}
